# Servidor do front do módulo. A porta vem da variável PORTA (Contrato §13.3).
server {
    listen ${PORTA};
    server_name _;
    root /usr/share/nginx/html;

    # Só a própria plataforma pode embutir esta página (Contrato §12.8)
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header X-Content-Type-Options nosniff always;

    location = /modulos/crm {
        return 301 /modulos/crm/;
    }

    location /modulos/crm/ {
        try_files $uri $uri/ /modulos/crm/index.html;
    }

    location /modulos/crm/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
    }
}
